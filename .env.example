# Environment configuration template for PayPal Reconciliation Agent
# Copy this file to .env and fill in real values. Never commit .env with real credentials.

# Database URL (PostgreSQL recommended for production; SQLite supported for development)
# Local Postgres example: postgresql+psycopg://postgres:postgres@localhost:5432/reconcile_test
# Local SQLite example: sqlite:///recon.db
RECONCILE_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reconcile_test

# PayPal REST API Credentials (Sandbox by default)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_ENVIRONMENT=sandbox

# PayPal Webhook ID (Created in PayPal Developer Dashboard or via PayPal Webhook API)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Administrative API Authentication Token (Minimum 32 random characters recommended)
ADMIN_API_KEY=your_secure_admin_api_key_here
# Comma-separated browser origins allowed to call the API. Leave empty when the
# dashboard is served from the API origin or through the Vite proxy.
CORS_ALLOWED_ORIGINS=

# Tenant Scoping (Default tenant identifier)
DEFAULT_TENANT_ID=default

# Webhook payload protection (default 1MB = 1048576 bytes)
MAX_REQUEST_BODY_BYTES=1048576

# D6 AI Exception Investigator Configuration (Zero-cost local inference)
# Options: "mock" (default, deterministic offline tests) or "ollama" (local Ollama instance)
MODEL_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
